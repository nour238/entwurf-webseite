---
import { Picture } from 'astro:assets';
import niches from '../assets/img/cafe-nischen.jpg';
import hours from '../data/hours.json';
import site from '../data/site.json';
import { hasHours } from '../lib/hours.js';
import { hasText } from '../lib/content.js';
import HoursTable from './HoursTable.astro';

const hoursKnown = hasHours(hours);
const hasMapLink = hasText(site.mapsUrl);
---

<section id="besuch" class="section section--green on-green" aria-labelledby="visit-title">
  <div class="container visit__grid">
    <div class="visit__info reveal">
      <p class="eyebrow">Besuch</p>
      <h2 id="visit-title">Eisenbahnstraße 6.</h2>
      <p class="visit__address">Homburg/Saar</p>

      <div class="visit__hours">
        <p class="visit__label">Öffnungszeiten</p>
        {hoursKnown ? (
          <HoursTable hours={hours} />
        ) : (
          <p>{site.status === 'open' ? 'Öffnungszeiten folgen.' : 'Öffnungszeiten folgen zur Eröffnung.'}</p>
        )}
      </div>

      {hasMapLink && (
        <div class="visit__map">
          <p class="visit__label">Anfahrt</p>
          <a
            class="text-link"
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >In Google Maps öffnen</a>
        </div>
      )}
    </div>

    <div class="visit__aside reveal">
      <Picture
        src={niches}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 1080]}
        sizes="(min-width: 900px) 32vw, 100vw"
        alt="Wandnischen mit Keramikvasen und warmem Licht"
        loading="lazy"
        class="visit__photo"
      />
      {site.status !== 'open' && <p class="visit__note">Bis bald in der Eisenbahnstraße.</p>}
    </div>
  </div>
</section>
