---
import logo from '../assets/img/logo-halari-transparent.webp';
import site from '../data/site.json';
import { withBase } from '../lib/paths.js';

const year = new Date().getFullYear();
const statusLine = site.status === 'open' ? 'Eisenbahnstraße 6, Homburg.' : 'Bald in der Eisenbahnstraße.';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__brand-link" href={withBase('/')}>
          <img
            class="footer__logo"
            src={logo.src}
            width="480"
            height="480"
            alt="Halari – Breakfast. Coffee. Cake."
            loading="lazy"
          />
        </a>
        <p class="footer__address">Eisenbahnstraße 6<br />Homburg/Saar</p>
      </div>

      <nav class="footer__nav" aria-label="Footer Navigation">
        <a class="footer__link" href={withBase('/#cafe')}>Café</a>
        <a class="footer__link" href={withBase('/#speisekarte')}>Speisekarte</a>
        <a class="footer__link" href={withBase('/#besuch')}>Besuch</a>
        <a class="footer__link" href={withBase('/#jobs')}>Jobs</a>
      </nav>

      <div class="footer__contact">
        <a class="footer__link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a
          class="footer__link"
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >Instagram</a>
        <a
          class="footer__link"
          href={site.social.tiktok}
          target="_blank"
          rel="noopener noreferrer"
        >TikTok</a>
      </div>

      <div class="footer__legal">
        <a class="footer__link" href={withBase('/impressum/')}>Impressum</a>
        <a class="footer__link" href={withBase('/datenschutz/')}>Datenschutz</a>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} Halari</p>
      <p>{statusLine}</p>
    </div>
  </div>
</footer>
