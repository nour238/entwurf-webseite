---
import site from '../data/site.json';
import { hasText } from '../lib/content.js';

const email = hasText(site.contact.email) ? site.contact.email : null;
const phone = hasText(site.contact.phone) ? site.contact.phone : null;
---

<section id="kontakt" class="section section--contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro reveal">
      <p class="eyebrow">Kontakt</p>
      <h2 id="contact-title">Schreib uns.</h2>
      <p class="lead">Fragen, Bewerbungen oder ein Hallo.</p>
    </div>

    <div class="contact__links reveal">
      {email && (
        <a class="contact__email" href={`mailto:${email}`}>{email}</a>
      )}

      <div class="contact__social">
        <a
          class="text-link"
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >Instagram</a>
        <a
          class="text-link"
          href={site.social.tiktok}
          target="_blank"
          rel="noopener noreferrer"
        >TikTok</a>
      </div>

      <p class="contact__address">Eisenbahnstraße 6<br />Homburg/Saar</p>

      {phone && <p class="contact__note">{phone}</p>}
    </div>
  </div>
</section>
