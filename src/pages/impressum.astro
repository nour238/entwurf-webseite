  noindex
>
  <section class="page">
    <div class="container page__inner">
      <p class="eyebrow">Rechtliches</p>
      <h1>Impressum</h1>
      <p>Die vollständigen Anbieterangaben werden vor der Eröffnung ergänzt.</p>

      <h2>Anschrift</h2>
      <p>Halari<br />Eisenbahnstraße 6<br />Homburg/Saar</p>

      <h2>Kontakt</h2>
      <p><a class="text-link" href="mailto:cafe.halari@web.de">cafe.halari@web.de</a></p>

      <h2>Betreiber</h2>
      <p>Angaben folgen.</p>

      <h2>Vertretung und Registereintrag</h2>
      <p>Angaben folgen.</p>

      <h2>Umsatzsteuer-ID</h2>
      <p>Angaben folgen, falls vorhanden.</p>

      <h2>Verantwortlich für den Inhalt</h2>
      <p>Angaben folgen.</p>
