---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { withBase } from '../lib/paths.js';

const {
  title = 'Halari | Frühstück, Kaffee & Kuchen in Homburg/Saar',
  description = 'Café Halari in der Eisenbahnstraße 6 in Homburg/Saar. Frühstück, Kaffee und Kuchen.',
  noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site
  ? new URL(withBase('/og-image.jpg'), Astro.site).href
  : withBase('/og-image.jpg');
const isHome = Astro.url.pathname === '/';
// Draft deploys stay out of search engines until the operator sets
// "indexable": true in src/data/site.json.
const robotsNoindex = noindex || site.indexable !== true;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#495645" />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link
      rel="preload"
      href={withBase('/fonts/cormorant-garamond-500.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/hanken-grotesk-var.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Halari" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main" class:list={[{ home: isHome }]}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
